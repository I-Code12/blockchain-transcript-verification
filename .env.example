NODE_ENV=development
HOST=127.0.0.1
PORT=4000
PUBLIC_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000
DATABASE_PATH=./transcript_storage/nexusverify.db
DATABASE_URL=
DATABASE_SSL=true
BLOCKCHAIN_DEPLOYMENT=local
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_NETWORK_NAME=NexusVerify Local Ethereum
BLOCK_EXPLORER_URL=
ADMIN_API_KEY=
REGISTRAR_PRIVATE_KEY=
REGISTRAR_MNEMONIC=
SEED_DEMO_DATA=true

# Public deployment requirements:
# - Set NODE_ENV=production and HOST=0.0.0.0.
# - Use a new DATABASE_PATH on persistent storage.
# - Store ADMIN_API_KEY and REGISTRAR_PRIVATE_KEY only as hosting secrets.
# - Never commit an RPC provider key, registrar key, access key or real transcript.
